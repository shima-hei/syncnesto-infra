project_name   = "syncnesto"
app_env = "production"
# デモ専用DB・privateバケットへの接続をruntimeで設定後にtrueにする。
demo_data_isolated = false
vercel_team_id = "team_WyjvWWMPeMn7kxuteyNsC7EE"

# まずは空のVercelプロジェクトとNeon DBを作る。
connect_github = false
backend_api_url = null
backend_allowed_hosts = []

# 後からFastAPIの公開先に合わせて設定する。
# backend_api_url = "https://syncnesto-api.vercel.app"
# URLを設定してapplyした後にconnect_github = trueへ変更する。

neon_region_id         = "aws-ap-southeast-1"
vercel_function_region = "sin1"
# Freeプランであることを確認済みの作成先組織。
neon_organization_id = "org-empty-dew-85265327"
