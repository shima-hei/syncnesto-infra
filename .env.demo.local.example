# chmod 600 .env.demo.local。デモ専用Projectの作成・費用確認後に設定する。
# 通常のSUPABASE_S3_*は流用しない。Project refは20文字の英小文字。
DEMO_SUPABASE_PROJECT_REF=
DEMO_SUPABASE_S3_ACCESS_KEY_ID=
DEMO_SUPABASE_S3_SECRET_ACCESS_KEY=
# 準備用scoped PAT。対象はデモProjectだけ。
# Project Settings / API Keys / API Key SecretsをそれぞれReadにする。
# 空の場合のみ、export済みSUPABASE_ACCESS_TOKENを使用する。
DEMO_SUPABASE_ACCESS_TOKEN=
